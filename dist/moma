# Read a masked value from the active terminal.
_moma_read_secret() {
  local target_var="$1"
  local mask="${2:-*}"
  local secret_value=""
  local character

  if [[ ! -t 0 ]]; then
    IFS= read -r secret_value || return $?
    printf -v "$target_var" '%s' "$secret_value"
    return 0
  fi

  local read_status
  while true; do
    IFS= read -r -s -n 1 character
    read_status=$?
    if ((read_status != 0)); then
      printf '\n' >&2
      return "$read_status"
    fi

    if [[ -z "$character" ]]; then
      printf '\n' >&2
      break
    fi

    case "$character" in
      $'\177' | $'\b')
        if [[ -n "$secret_value" ]]; then
          secret_value="${secret_value%?}"
          printf '\b \b' >&2
        fi
        ;;
      *)
        secret_value+="$character"
        printf '%s' "$mask" >&2
        ;;
    esac
  done

  printf -v "$target_var" '%s' "$secret_value"
}

