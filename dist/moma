    printf '%b  ┌─ %s %s┐%b\n' \
      "$resolved_color" "$label" \
      "$(_moma_repeat_char "─" "$dash_count")" "$reset"
  else
    printf '%b  ┌%s┐%b\n' \
      "$resolved_color" \
      "$(_moma_repeat_char "─" "$dash_count")" "$reset"
