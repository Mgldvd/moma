# Dispatch Markdown, browser, and terminal previews.
_moma_preview() {
  case "${1:-}" in
    md)
      shift
      _moma_preview_reject_extra_args md "$@" || return 1
      _moma_preview_markdown
      return 0
      ;;
    web)
