_moma_read_secret () {
    local target_var="$1"
    local mask="${2:-*}"
    local secret_value=""
    local character

    if [[ ! -t 0 ]]; then
        IFS= read -r secret_value || return $?
        printf -v "$target_var" '%s' "$secret_value"
        return 0
    fi

    while true; do
        if ! IFS= read -r -s -n 1 character; then
            printf '\n' >&2
            return 1
        fi

        if [[ -z "$character" ]]; then
            printf '\n' >&2
            break
        fi

        case "$character" in
            $'\177'|$'\b')
                if [[ -n "$secret_value" ]]; then
                    secret_value="${secret_value%?}"
                    printf '\b \b' >&2
                fi
                ;;
            *)
                secret_value+="$character"
                printf '%s' "$mask" >&2
                ;;
        esac
    done

    printf -v "$target_var" '%s' "$secret_value"
}

