                sequence=""
                IFS= read -r -s -n 2 -t 0.1 sequence || true
                case "$sequence" in
                    '[A') selected_index=$(( (selected_index - 1 + ${#options[@]}) % ${#options[@]} )) ;;
                    '[B') selected_index=$(( (selected_index + 1) % ${#options[@]} )) ;;
