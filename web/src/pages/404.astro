---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
import { SITE } from "../data/site";
---

<BaseLayout
    title={`Page not found — ${SITE.title}`}
    description="This page does not exist in the Moma documentation."
    noindex
>
    <Header version={SITE.version} repoUrl={SITE.repoUrl} />

    <main class="not-found" id="top">
        <p class="not-found__eyebrow">404</p>
        <h1 class="not-found__title">Page not found</h1>
        <p class="not-found__intro">
            That page doesn't exist. Head back to the <a
                class="not-found__link"
                href={import.meta.env.BASE_URL}>API reference</a
            >.
        </p>
    </main>

    <Footer repoUrl={SITE.repoUrl} functionCount={SITE.functionCount} />
</BaseLayout>

<style>
    .not-found {
        box-sizing: border-box;
        width: min(100% - 2rem, var(--docs-max-width));
        margin: 0 auto;
        padding: 5rem 0;
        text-align: center;
    }

    .not-found__eyebrow {
        margin: 0 0 0.85rem;
        color: var(--cyan);
        font: 800 calc(0.72rem + 2px) var(--font-mono);
        letter-spacing: 0.08em;
    }

    .not-found__title {
        margin: 0;
        font-size: clamp(2rem, 7vw, 2.65rem);
        font-weight: 780;
        letter-spacing: -0.065em;
    }

    .not-found__intro {
        max-width: 30rem;
        margin: 1rem auto 0;
        color: var(--muted);
        font-size: calc(1.05rem + 2px);
        line-height: 1.75;
    }

    .not-found__link {
        color: var(--pink);
    }
</style>
