---
import { Image } from 'astro:assets';
import './Header.scss';
import brandMark from '../../assets/moma-1m2vh.png';
import type { Props } from './Header.types';

const { version, repoUrl } = Astro.props as Props;
---

<header class="topbar">
  <a class="brand" href="#top" aria-label={`Moma documentation home, version ${version}`}>
    <Image class="brand__mark" src={brandMark} alt="moma" width={128} height={128} />
    <span class="brand__name">moma<span class="brand__cursor">_</span></span>
    <span class="brand__version" data-moma-version={version}>v{version}</span>
    <span class="brand__label">documentation</span>
  </a>
  <nav class="topbar__nav" aria-label="Documentation sections">
    <a class="topbar__link" href="#components">Components</a>
    <a class="topbar__link" href="#helpers">Helpers</a>
    <a class="topbar__link" href="#cli">CLI</a>
  </nav>
  <div class="topbar__actions">
    <a class="github-link" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="View moma on GitHub">
      <svg class="github-link__icon" aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
      <span class="github-link__text">GitHub</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="docs-nav">
      <span class="nav-toggle__icon" aria-hidden="true">☰</span>
      <span class="nav-toggle__text">Browse components</span>
    </button>
    <button class="theme-toggle" type="button" aria-label="Use dark theme" aria-pressed="false">
      <span class="theme-toggle__icon" aria-hidden="true">◐</span>
      <span class="theme-toggle__text">Theme</span>
    </button>
  </div>
</header>

<script>
  import './Header.client';
</script>
