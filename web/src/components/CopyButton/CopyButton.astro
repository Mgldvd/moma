---
import "./CopyButton.scss";
import type { Props } from "./CopyButton.types";

const {
    text,
    label = "Copy command to clipboard",
    variant = "floating",
} = Astro.props as Props;
---

<button
    type="button"
    class:list={["copy-btn", { "copy-btn--inline": variant === "inline" }]}
    data-copy-text={text}
    aria-label={label}
>
    Copy
</button>

<script>
    import "./CopyButton.client";
</script>
