---
import './TerminalWindow.scss';
import type { Props } from './TerminalWindow.types';

const { title = 'preview', ariaLabel } = Astro.props as Props;
---

<div class="terminal-window" role="group" aria-label={ariaLabel}>
  <div class="terminal-window__chrome" aria-hidden="true">
    <span class="terminal-window__title">{title}</span>
    <span class="terminal-window__controls">
      <span class="terminal-window__control terminal-window__control--success"></span>
      <span class="terminal-window__control terminal-window__control--warning"></span>
      <span class="terminal-window__control terminal-window__control--error"></span>
    </span>
  </div>
  <pre class="terminal-window__body"><slot /></pre>
</div>
