---
import { Image } from 'astro:assets';
import './ApiEntry.scss';
import CopyButton from '../CopyButton/CopyButton.astro';
import TerminalWindow from '../TerminalWindow/TerminalWindow.astro';
import { getScreenshot } from '../../data/screenshots';
import type { Props } from './ApiEntry.types';

const { id, kind, name, descriptionHtml, signature, searchText, examples, wireframe } = Astro.props as Props;

// Every entry's output preview is a real screenshot (screenshots.ts, keyed
// by id) except moma-update, which performs a real network install and
// falls back to the one remaining hand-authored wireframe.
const screenshot = getScreenshot(id);
const hasPreview = Boolean(screenshot || wireframe);

// Examples are only shown alongside an output preview - in practice every
// entry has one now that real screenshots exist for the whole catalog, but
// this guard is what silently hid moma-select's examples on the old site
// (it had neither a hand-authored wireframe nor, until now, a screenshot).
const showExamples = Boolean(hasPreview && examples && examples.length > 0);
---

<article class="api-entry" id={id} data-api={searchText}>
  <header class="api-entry__header">
    <div>
      <p class="api-entry__kind">{kind}</p>
      <h3 class="api-entry__name">{name}</h3>
    </div>
  </header>
  <p class="api-entry__description" set:html={descriptionHtml} />
  <div class="code-block">
    <code class="signature">{signature}</code>
    <CopyButton text={signature} />
  </div>

  {showExamples && (
    <section class="api-examples">
      <p class="api-examples__title">Bash examples</p>
      <div class="api-examples__list">
        {examples!.map((example) => (
          <pre class="api-examples__example"><code class="api-examples__code">{example}</code><CopyButton text={example} /></pre>
        ))}
      </div>
    </section>
  )}

  {screenshot ? (
    <div class="wireframe">
      <p class="wireframe__label">Output</p>
      <Image class="wireframe__screenshot" src={screenshot} alt={`${name} output`} loading="lazy" />
    </div>
  ) : wireframe && (
    <div class="wireframe">
      <p class="wireframe__label">Output</p>
      <TerminalWindow ariaLabel={`${name} output`}>
        <Fragment set:html={wireframe.bodyHtml} />
      </TerminalWindow>
    </div>
  )}
</article>

<script>
  import './ApiEntry.client';
</script>
