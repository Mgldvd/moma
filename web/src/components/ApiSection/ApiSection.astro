---
import './ApiSection.scss';
import type { Props } from './ApiSection.types';

const { id, number, title, intro, filterable = false } = Astro.props as Props;
---

<section class="api-section" id={id} data-filterable={filterable}>
  <header class="api-section__header">
    <p class="api-section__number">{number}</p>
    <h2 class="api-section__title">{title}</h2>
    <p class="api-section__intro">{intro}</p>
  </header>
  <slot />
</section>

<script>
  import './ApiSection.client';
</script>
